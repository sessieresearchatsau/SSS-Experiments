     "IC", ",", "RepeatingDecimal", ",", "ICDecimal", ",", "icNeedsParensQ", ",",
      "parenthesizedBoxes"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"decimalExpansionData", "[", "r_Rational", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"num", "=", 
         RowBox[{"Numerator", "[", "r", "]"}]}], ",", 
        RowBox[{"den", "=", 
         RowBox[{"Denominator", "[", "r", "]"}]}], ",", "sign", ",", 
        "intPart", ",", "rem", ",", 
        RowBox[{"fracDigits", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"seen", "=", 
         RowBox[{"<|", "|>"}]}], ",", 
        RowBox[{"pos", "=", "1"}], ",", "q", ",", "prefixLength", ",", 
        "periodLength"}], "}"}], ",", 
      RowBox[{
       RowBox[{"sign", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"num", "<", "0"}], ",", 
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"num", "=", 
        RowBox[{"Abs", "[", "num", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"intPart", "=", 
        RowBox[{"Quotient", "[", 
         RowBox[{"num", ",", "den"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rem", "=", 
        RowBox[{"Mod", "[", 
         RowBox[{"num", ",", "den"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rem", "=!=", "0"}], "&&", 
          RowBox[{"!", 
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"seen", ",", "rem"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"seen", "[", "rem", "]"}], "=", "pos"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"q", "=", 
           RowBox[{"Quotient", "[", 
            RowBox[{
             RowBox[{"10", " ", "rem"}], ",", "den"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"rem", "=", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"10", " ", "rem"}], ",", "den"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"fracDigits", ",", "q"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"pos", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rem", "==", "0"}], ",", 
         RowBox[{
          RowBox[{"prefixLength", "=", 
           RowBox[{"Length", "[", "fracDigits", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"periodLength", "=", "0"}]}], ",", 
         RowBox[{
          RowBox[{"prefixLength", "=", 
           RowBox[{
            RowBox[{"seen", "[", "rem", "]"}], "-", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"periodLength", "=", 
           RowBox[{
            RowBox[{"Length", "[", "fracDigits", "]"}], "-", 
            "prefixLength"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rational\>\"", "->", "r"}], ",", 
         RowBox[{"\"\<Sign\>\"", "->", "sign"}], ",", 
         RowBox[{"\"\<IntegerPart\>\"", "->", "intPart"}], ",", 
         RowBox[{"\"\<Digits\>\"", "->", "fracDigits"}], ",", 
         RowBox[{"\"\<NonrepeatingLength\>\"", "->", "prefixLength"}], ",", 
         RowBox[{"\"\<RepeatingLength\>\"", "->", "periodLength"}], ",", 
         RowBox[{"\"\<NonrepeatingPart\>\"", "->", 
          RowBox[{"Take", "[", 
           RowBox[{"fracDigits", ",", "prefixLength"}], "]"}]}], ",", 
         RowBox[{"\"\<RepeatingPart\>\"", "->", 
          RowBox[{"Take", "[", 
           RowBox[{"fracDigits", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"prefixLength", "+", "1"}], ",", 
              RowBox[{"prefixLength", "+", "periodLength"}]}], "}"}]}], 
           "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
