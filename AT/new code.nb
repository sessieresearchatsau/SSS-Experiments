    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"num", "=", 
         RowBox[{"Numerator", "[", "r", "]"}]}], ",", 
        RowBox[{"den", "=", 
         RowBox[{"Denominator", "[", "r", "]"}]}], ",", "sign", ",", 
