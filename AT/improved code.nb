Cell[TextData[{
 "For the tested cases with more than three repetitions of \
\[OpenCurlyQuote]27,\[CloseCurlyQuote] multiplying by 37 produces a decimal \
beginning with ",
 StyleBox["n",
  FontSlant->"Italic"],
 " - 2 repetitions of \[OpenCurlyQuote]09,\[CloseCurlyQuote] followed by \
\[OpenCurlyQuote]0899,\[CloseCurlyQuote] where ",
 StyleBox["n",
  FontSlant->"Italic"],
 " is the original repeat count."
