 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"finiteRepeatData", "[", "digits_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"length", "=", 
         RowBox[{"StringLength", "[", "digits", "]"}]}], ",", 
        RowBox[{"best", "=", 
         RowBox[{"Missing", "[", "\"\<NoRepeat\>\"", "]"}]}], ",", 
        RowBox[{"bestLength", "=", "0"}], ",", "start", ",", "width", ",", 
        "block", ",", "count", ",", "runLength"}], "}"}], ",", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"start", "=", "1"}], ",", 
         RowBox[{"start", "<=", 
          RowBox[{"length", "-", "1"}]}], ",", 
         RowBox[{"start", "++"}], ",", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"width", "=", "1"}], ",", 
            RowBox[{"width", "<=", 
             RowBox[{"Quotient", "[", 
              RowBox[{
               RowBox[{"length", "-", "start", "+", "1"}], ",", "2"}], 
              "]"}]}], ",", 
            RowBox[{"width", "++"}], ",", 
            RowBox[{
             RowBox[{"block", "=", 
              RowBox[{"StringTake", "[", 
               RowBox[{"digits", ",", 
                RowBox[{"{", 
                 RowBox[{"start", ",", 
                  RowBox[{"start", "+", "width", "-", "1"}]}], "}"}]}], 
               "]"}]}], ";", "\n", 
             RowBox[{"count", "=", "1"}], ";", "\n", "\[IndentingNewLine]", 
             RowBox[{"While", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"start", "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"count", "+", "1"}], ")"}], " ", "width"}], "-", 
                  "1"}], "<=", "length"}], "&&", 
                RowBox[{
                 RowBox[{"StringTake", "[", 
                  RowBox[{"digits", ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"start", "+", 
                    RowBox[{"count", " ", "width"}]}], ",", 
                    RowBox[{"start", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"count", "+", "1"}], ")"}], " ", "width"}], "-", 
                    "1"}]}], "}"}]}], "]"}], "===", "block"}]}], ",", 
               RowBox[{
                RowBox[{"count", "++"}], ";"}]}], "]"}], ";", "\n", 
             "\[IndentingNewLine]", 
             RowBox[{"runLength", "=", 
              RowBox[{"count", " ", "width"}]}], ";", "\n", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"count", ">=", "2"}], "&&", 
                RowBox[{"runLength", ">", "bestLength"}]}], ",", 
               RowBox[{
                RowBox[{"bestLength", "=", "runLength"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"best", "=", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<Prefix\>\"", "->", 
                    RowBox[{"StringTake", "[", 
                    RowBox[{"digits", ",", 
                    RowBox[{"start", "-", "1"}]}], "]"}]}], ",", 
                   RowBox[{"\"\<Block\>\"", "->", "block"}], ",", 
                   RowBox[{"\"\<Count\>\"", "->", "count"}], ",", 
                   RowBox[{"\"\<Suffix\>\"", "->", 
                    RowBox[{"StringDrop", "[", 
                    RowBox[{"digits", ",", 
                    RowBox[{"start", "+", "runLength", "-", "1"}]}], 
                    "]"}]}]}], "|>"}]}], ";"}]}], "]"}], ";"}]}], "\n", "]"}],
           ";"}]}], "\n", "]"}], ";", "\n", "\[IndentingNewLine]", "best"}]}],
      "\n", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
