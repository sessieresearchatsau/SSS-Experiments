  RowBox[{
   RowBox[{
    RowBox[{"decimalExpansionData", "[", "r_Rational", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"num", "=", 
         RowBox[{"Numerator", "[", "r", "]"}]}], ",", 
        RowBox[{"den", "=", 
         RowBox[{"Denominator", "[", "r", "]"}]}], ",", "sign", ",", 
        "intPart", ",", "rem", ",", 
        RowBox[{"fracDigits", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"seen", "=", 
         RowBox[{"<|", "|>"}]}], ",", 
        RowBox[{"pos", "=", "1"}], ",", "q", ",", "prefixLength", ",", 
        "periodLength"}], "}"}], ",", 
      RowBox[{
       RowBox[{"sign", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"num", "<", "0"}], ",", 
          RowBox[{"-", "1"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"num", "=", 
        RowBox[{"Abs", "[", "num", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"intPart", "=", 
        RowBox[{"Quotient", "[", 
         RowBox[{"num", ",", "den"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rem", "=", 
        RowBox[{"Mod", "[", 
         RowBox[{"num", ",", "den"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rem", "=!=", "0"}], "&&", 
          RowBox[{"!", 
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"seen", ",", "rem"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"seen", "[", "rem", "]"}], "=", "pos"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"q", "=", 
           RowBox[{"Quotient", "[", 
            RowBox[{
             RowBox[{"10", " ", "rem"}], ",", "den"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"rem", "=", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"10", " ", "rem"}], ",", "den"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"fracDigits", ",", "q"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"pos", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
