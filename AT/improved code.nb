          "\[IndentingNewLine]", 
          RowBox[{"periodLength", "=", "0"}]}], ",", 
         RowBox[{
          RowBox[{"prefixLength", "=", 
           RowBox[{
            RowBox[{"seen", "[", "rem", "]"}], "-", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"periodLength", "=", 
           RowBox[{
            RowBox[{"Length", "[", "fracDigits", "]"}], "-", 
            "prefixLength"}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
