Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"result", "=", 
            RowBox[{"m", "/", "9801"}]}], ",", 
           RowBox[{"cancellation", "=", 
            RowBox[{"GCD", "[", 
             RowBox[{"m", ",", "9801"}], "]"}]}], ",", 
           RowBox[{"period", "=", 
            RowBox[{"Length", "[", 
             RowBox[{
              RowBox[{"RealDigits", "[", 
               RowBox[{"m", "/", "9801"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "result", ",", "cancellation", ",", "period", ",", 
           RowBox[{"198", "/", "period"}], ",", 
           RowBox[{"cancellation", "==", 
            RowBox[{"198", "/", "period"}]}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{"{", 
          RowBox[{"264", ",", "396", ",", "9"}], "}"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Multiplier\>\"", ",", "\"\<Reduced product\>\"", 
       ",", "\"\<Cancellation factor\>\"", ",", "\"\<New period\>\"", 
       ",", "\"\<Period reduction factor\>\"", 
       ",", "\"\<Factors match?\>\""}], "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{4.0017023136326*^9, 4.001702313635049*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"7125c107-40d7-4b20-b862-8297722654c7"],

