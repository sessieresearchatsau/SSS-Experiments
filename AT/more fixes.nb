             RowBox[{"primary", "[", "\"\<Count\>\"", "]"}]}]}], ",", 
           RowBox[{"\"\<RepeatRuns\>\"", "->", "runs"}], ",", 
           RowBox[{"\"\<Formatted\>\"", "->", "formatted"}]}], "|>"}]}], 
        "]"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Exact", " ", "fraction", " ", "for", " ", "a", " ", "block", " ", 
    "repeated", " ", "a", " ", "finite", " ", "number", " ", "of", " ", 
    RowBox[{"times", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"finiteRepeatFraction", "[", 
