       RowBox[{"prefixLength", "=", 
        RowBox[{"data", "[", "\"\<NonrepeatingLength\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"periodLength", "=", 
        RowBox[{"data", "[", "\"\<RepeatingLength\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"parts", "=", 
        RowBox[{"icDigitParts", "[", "whole", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"prefix", "!=", "\"\<\>\""}], "||", 
          RowBox[{"period", "!=", "\"\<\>\""}]}], ",", 
         RowBox[{"parts", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"parts", ",", 
            RowBox[{"{", "\"\<.\>\"", "}"}], ",", 
            RowBox[{"icDigitParts", "[", "prefix", "]"}]}], "]"}]}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"periodLength", ">", "0"}], ",", 
         RowBox[{
          RowBox[{"tailSpec", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"prefixLength", "==", "0"}], ",", "Infinity", ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", 
               RowBox[{"prefixLength", "+", "1"}], ",", "Infinity"}], "}"}]}],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"parts", ",", 
            RowBox[{"IC", "[", 
             RowBox[{"period", ",", "tailSpec"}], "]"}]}], "]"}]}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"runs", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{"parts", ",", 
          RowBox[{
           RowBox[{"IC", "[", 
            RowBox[{"pieces__", ",", "spec_"}], "]"}], ":>", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Block\>\"", "->", 
              RowBox[{"icBlockDigits", "[", 
               RowBox[{"{", "pieces", "}"}], "]"}]}], ",", 
             RowBox[{"\"\<Count\>\"", "->", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"ListQ", "[", "spec", "]"}], ",", 
                RowBox[{"Last", "[", "spec", "]"}], ",", "spec"}], "]"}]}]}], 
            "|>"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"primary", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"runs", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Block\>\"", "->", "\"\<\>\""}], ",", 
            RowBox[{"\"\<Count\>\"", "->", "0"}]}], "|>"}], ",", 
          RowBox[{"First", "[", 
           RowBox[{"MaximalBy", "[", 
            RowBox[{"runs", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"StringLength", "[", 
                RowBox[{"#", "[", "\"\<Block\>\"", "]"}], "]"}], " ", 
               RowBox[{"#", "[", "\"\<Count\>\"", "]"}]}], "&"}]}], "]"}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"formatted", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Notation\>\"", "]"}], 
           "===", "\"\<IC\>\""}], ",", 
          RowBox[{"ICNumber", "[", 
           RowBox[{
            RowBox[{"data", "[", "\"\<Sign\>\"", "]"}], ",", "parts"}], "]"}],
           ",", 
          RowBox[{"periodLength", ">", "0"}], ",", 
          RowBox[{"RepeatingDecimal", "[", 
           RowBox[{
            RowBox[{"data", "[", "\"\<Sign\>\"", "]"}], ",", 
            RowBox[{"data", "[", "\"\<IntegerPart\>\"", "]"}], ",", "prefix", 
            ",", "period"}], "]"}], ",", 
          RowBox[{"IntegerQ", "[", "r", "]"}], ",", "r", ",", "True", ",", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"r", "<", "0"}], ",", "\"\<-\>\"", ",", "\"\<\>\""}], 
              "]"}], ",", "whole", ",", "\"\<.\>\"", ",", "prefix"}], "}"}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{"data", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<RepeatBlock\>\"", "->", 
            RowBox[{"primary", "[", "\"\<Block\>\"", "]"}]}], ",", 
