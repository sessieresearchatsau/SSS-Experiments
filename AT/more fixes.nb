                RowBox[{"#", "[", "\"\<Block\>\"", "]"}], "]"}], " ", 
               RowBox[{"#", "[", "\"\<Count\>\"", "]"}]}], "&"}]}], "]"}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"formatted", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<Notation\>\"", "]"}], 
           "===", "\"\<IC\>\""}], ",", 
          RowBox[{"ICNumber", "[", 
           RowBox[{
            RowBox[{"data", "[", "\"\<Sign\>\"", "]"}], ",", "parts"}], "]"}],
           ",", 
          RowBox[{"periodLength", ">", "0"}], ",", 
          RowBox[{"RepeatingDecimal", "[", 
           RowBox[{
            RowBox[{"data", "[", "\"\<Sign\>\"", "]"}], ",", 
            RowBox[{"data", "[", "\"\<IntegerPart\>\"", "]"}], ",", "prefix", 
            ",", "period"}], "]"}], ",", 
          RowBox[{"IntegerQ", "[", "r", "]"}], ",", "r", ",", "True", ",", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"r", "<", "0"}], ",", "\"\<-\>\"", ",", "\"\<\>\""}], 
              "]"}], ",", "whole", ",", "\"\<.\>\"", ",", "prefix"}], "}"}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{"data", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<RepeatBlock\>\"", "->", 
            RowBox[{"primary", "[", "\"\<Block\>\"", "]"}]}], ",", 
           RowBox[{"\"\<BlockLength\>\"", "->", 
            RowBox[{"StringLength", "[", 
             RowBox[{"primary", "[", "\"\<Block\>\"", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<RepeatCount\>\"", "->", 
            RowBox[{"primary", "[", "\"\<Count\>\"", "]"}]}], ",", 
           RowBox[{"\"\<RepeatedDigitCount\>\"", "->", 
            RowBox[{
             RowBox[{"StringLength", "[", 
              RowBox[{"primary", "[", "\"\<Block\>\"", "]"}], "]"}], " ", 
             RowBox[{"primary", "[", "\"\<Count\>\"", "]"}]}]}], ",", 
           RowBox[{"\"\<RepeatRuns\>\"", "->", "runs"}], ",", 
           RowBox[{"\"\<Formatted\>\"", "->", "formatted"}]}], "|>"}]}], 
        "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Exact", " ", "fraction", " ", "for", " ", "a", " ", "block", " ", 
    "repeated", " ", "a", " ", "finite", " ", "number", " ", "of", " ", 
    RowBox[{"times", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"finiteRepeatFraction", "[", 
     RowBox[{"block_String", ",", 
      RowBox[{"count_Integer", "?", "Positive"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"digits", "=", 
        RowBox[{"StringRepeat", "[", 
         RowBox[{"block", ",", "count"}], "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"FromDigits", "[", "digits", "]"}], "/", 
       RowBox[{"10", "^", 
        RowBox[{"StringLength", "[", "digits", "]"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Exact", " ", "fraction", " ", "for", " ", "a", " ", "decimal", " ", 
     "prefix", " ", "followed", " ", "by", " ", "an", " ", "infinite", " ", 
     RowBox[{"repeat", ".", "For"}], " ", "example"}], ",", 
    RowBox[{
     RowBox[{"extendRepeat", "[", 
      RowBox[{"\"\<12\>\"", ",", "\"\<27\>\""}], "]"}], " ", "gives", " ", 
     RowBox[{"27", "/", "220."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"extendRepeat", "[", 
     RowBox[{"prefix_String", ",", "block_String"}], "]"}], "/;", 
    RowBox[{
     RowBox[{"StringMatchQ", "[", 
      RowBox[{"prefix", ",", 
       RowBox[{"RegularExpression", "[", "\"\<[0-9]*\>\"", "]"}]}], "]"}], "&&", 
     RowBox[{"StringMatchQ", "[", 
      RowBox[{"block", ",", 
       RowBox[{"RegularExpression", "[", "\"\<[0-9]+\>\"", "]"}]}], "]"}]}]}],
    ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"prefixValue", ",", "prefixScale", ",", "blockDenominator"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"prefixValue", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"prefix", "===", "\"\<\>\""}], ",", "0", ",", 
         RowBox[{"FromDigits", "[", "prefix", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"prefixScale", "=", 
       RowBox[{"10", "^", 
        RowBox[{"StringLength", "[", "prefix", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"blockDenominator", "=", 
