            RowBox[{"StringLength", "[", 
             RowBox[{"primary", "[", "\"\<Block\>\"", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<RepeatCount\>\"", "->", 
            RowBox[{"primary", "[", "\"\<Count\>\"", "]"}]}], ",", 
           RowBox[{"\"\<RepeatedDigitCount\>\"", "->", 
            RowBox[{
             RowBox[{"StringLength", "[", 
